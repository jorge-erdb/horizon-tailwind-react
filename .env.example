# Nova Analytics — environment variables
#
# Copy this file to `.env.local` and fill in the real values. `.env.local` is
# gitignored; never commit real credentials.
#
# Create React App only exposes variables prefixed with REACT_APP_, and it
# inlines them into the JS bundle at build time. Restart `npm start` after
# changing anything here.

# Supabase project URL — Supabase dashboard > Project Settings > Data API
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key — same page, "Project API keys" > anon public.
# This key is safe to ship in a browser bundle; Row Level Security is what
# actually protects your data. Never put the service_role key here.
REACT_APP_SUPABASE_ANON_KEY=your-anon-public-key
